<sdf version="1.7">
  <world name="default">
    <!-- Ground and sun -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ramp -->
    <model name="ramp">
      <!-- x y z roll pitch yaw -->
      <pose>{{ramp_x}} 0 {{ramp_z}} 0 {{ramp_pitch}} 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>{{ramp_length}} {{ramp_width}} {{ramp_thickness}}</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>{{ramp_length}} {{ramp_width}} {{ramp_thickness}}</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.4 0.2 1</ambient>
            <diffuse>0.7 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Alleyway connected to ramp -->
<model name="alleyway">
  <pose>{{ alley_x }} 0 {{ alley_z }} 0 0 0</pose>
  <static>true</static>
  <link name="link">
    <collision name="collision">
      <geometry>
        <box>
          <size>{{ alley_length }} {{ ramp_width }} {{ ramp_thickness }}</size>
        </box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>{{ alley_length }} {{ ramp_width }} {{ ramp_thickness }}</size>
        </box>
      </geometry>
      <material>
        <ambient>0.5 0.5 0.5 1</ambient>
        <diffuse>0.5 0.5 0.5 1</diffuse>
      </material>
    </visual>
  </link>
</model>

  </world>
</sdf>

