<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="0">
    <General>
      <!-- Bind to all available interfaces inside the container -->
      <Interfaces>
        <NetworkInterface name="*"/>
      </Interfaces>
    </General>

    <Discovery>
      <Peers>
        <!-- Your robot IP on Windows Wi-Fi -->
        <!-- <Peer address="10.186.13.14"/> -->
        <Peer address="192.168.178.136"/>
      </Peers>
      <!-- Optional: participant index auto -->
      <ParticipantIndex>auto</ParticipantIndex>
    </Discovery>

    <!-- Optional: tuning network settings for WSL2/Docker -->
    <DomainQoS>
      <Reliability>
        <Kind>RELIABLE</Kind>
      </Reliability>
      <Durability>
        <Kind>TRANSIENT_LOCAL</Kind>
      </Durability>
    </DomainQoS>
  </Domain>
</CycloneDDS>
