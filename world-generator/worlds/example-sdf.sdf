<sdf version="1.7">
        <world name="default">
            <!-- Ground plane from Fuel -->
            <include>
            <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Ground%20Plane</uri>
            </include>

                <!-- Sun from Fuel -->
            <include>
            <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Sun</uri>
            </include>


        <model name="wall_corridor 1_left_d65fe213-285e-4cae-948f-eb8185c538a5">
            <static>true</static>
            <pose>25.0 3.0 0.0 0 0 0</pose>
            <link name="link">
                <visual name="visual">
                <geometry>
                    <mesh>
                    <uri>model://data/world-generator/assets/wall_unit.stl</uri>
                    <scale>10.0 1 1</scale> <!-- dont scale height, thickness -->
                    </mesh>
                </geometry>
                <material>
                    <ambient>0.6 0.4 0.2 1</ambient>
                    <diffuse>0.6 0.4 0.2 1</diffuse>
                </material>
                </visual>
                <collision name="collision">
                <geometry>
                        <box>
                            <size>10.0 0.1 1.2</size> <!-- match final scaled size -->
                        </box>
                </geometry>
                </collision>
            </link>
        </model>

        <model name="wall_corridor 1_right_89856c5e-dde7-4f8c-8872-ba32f885440b">
            <static>true</static>
            <pose>25.0 5.0 0.0 0 0 0</pose>
            <link name="link">
                <visual name="visual">
                <geometry>
                    <mesh>
                    <uri>model://data/world-generator/assets/wall_unit.stl</uri>
                    <scale>10.0 1 1</scale> <!-- dont scale height, thickness -->
                    </mesh>
                </geometry>
                <material>
                    <ambient>0.6 0.4 0.2 1</ambient>
                    <diffuse>0.6 0.4 0.2 1</diffuse>
                </material>
                </visual>
                <collision name="collision">
                <geometry>
                        <box>
                            <size>10.0 0.1 1.2</size> <!-- match final scaled size -->
                        </box>
                </geometry>
                </collision>
            </link>
        </model>

        <model name="floor_corridor 1_floor_5908da74-a622-4b85-83ce-c97b64f17417">
            <static>true</static>
            <pose>25.0 4.0 0.0 0 0 0</pose>
            <link name="link">
                <visual name="visual">
                <geometry>
                    <mesh>
                    <uri>model://data/world-generator/assets/floor_unit.stl</uri>
                    <scale>10.0 2.0 1</scale> <!-- dont scale thickness -->
                    </mesh>
                </geometry>
                <material>
                    <ambient>0.6 0.4 0.2 1</ambient>
                    <diffuse>0.6 0.4 0.2 1</diffuse>
                </material>
                </visual>
                <collision name="collision">
                <geometry>
                        <box>
                            <size>10.0 2.0 1</size> <!-- match final scaled size -->
                        </box>
                </geometry>
                </collision>
            </link>
        </model>


        </world>
        </sdf>