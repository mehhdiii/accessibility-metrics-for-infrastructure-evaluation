<sdf version="1.7">
        <world name="default">
            <!-- Ground plane from Fuel -->
            <include>
            <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Ground%20Plane</uri>
            </include>

                <!-- Sun from Fuel -->
            <include>
            <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Sun</uri>
            </include>


        <model name="wall_corridor 1_left_b7b69f93-e788-4f48-a783-6699f865e385">
            <static>true</static>
            <pose>25.0 3.0 0.0 0 0 0</pose>
            <link name="link">
                <visual name="visual">
                <geometry>
                    <mesh>
                    <uri>model://data/world-generator/assets/wall_unit.stl</uri>
                    <scale>10.0 1 1</scale> <!-- dont scale height, thickness -->
                    </mesh>
                </geometry>
                <material>
                    <ambient>0.6 0.4 0.2 1</ambient>
                    <diffuse>0.6 0.4 0.2 1</diffuse>
                </material>
                </visual>
                <collision name="collision">
                <geometry>
                        <box>
                            <size>10.0 0.1 1.2</size> <!-- match final scaled size -->
                        </box>
                </geometry>
                </collision>
            </link>
        </model>

        <model name="wall_corridor 1_right_9cfe37f7-ce24-4858-b6b5-1ee4875b1415">
            <static>true</static>
            <pose>25.0 5.0 0.0 0 0 0</pose>
            <link name="link">
                <visual name="visual">
                <geometry>
                    <mesh>
                    <uri>model://data/world-generator/assets/wall_unit.stl</uri>
                    <scale>10.0 1 1</scale> <!-- dont scale height, thickness -->
                    </mesh>
                </geometry>
                <material>
                    <ambient>0.6 0.4 0.2 1</ambient>
                    <diffuse>0.6 0.4 0.2 1</diffuse>
                </material>
                </visual>
                <collision name="collision">
                <geometry>
                        <box>
                            <size>10.0 0.1 1.2</size> <!-- match final scaled size -->
                        </box>
                </geometry>
                </collision>
            </link>
        </model>


    </world>
</sdf>